<?xml version="1.0" encoding="utf-8"?>
<!--
    SAVO home-screen widget — 3x2 cell layout (landscape).
    Left:   SAVO wordmark + rego plate + legend
    Center: rings
    Right:  camera tile
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/widget_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <!-- Left column: branding + plate + legend -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/widget_savo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVO"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/widget_plate_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/widget_rego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— — —"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.05"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:background="@drawable/widget_rego_plate"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:includeFontPadding="false" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:src="@drawable/widget_dot_green"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Ins"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/widget_dot_amber"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="WOF"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/widget_dot_blue"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Rego"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center: rings -->
        <ImageView
            android:id="@+id/widget_rings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_label" />

        <!-- Right: camera tile -->
        <FrameLayout
            android:id="@+id/widget_savo_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_actions_tile"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_actions_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_label" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
