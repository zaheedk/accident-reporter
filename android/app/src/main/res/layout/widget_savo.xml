<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Entire widget UI rendered as a single bitmap (landscape 4x2). -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label" />

    <!-- Tap regions overlay. The bitmap is laid out as three columns:
         left 30% rego/rings, middle 25% SAVO logo, right 45% three call buttons. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left: rego + rings → cycle vehicle -->
        <LinearLayout
            android:id="@+id/widget_plate_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30"
            android:clickable="true"
            android:focusable="true" />

        <!-- Middle: SAVO logo → quick capture -->
        <LinearLayout
            android:id="@+id/widget_savo_icon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="25"
            android:clickable="true"
            android:focusable="true" />

        <!-- Right: three call buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="45"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_call_roadside"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/widget_call_tow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/widget_call_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
