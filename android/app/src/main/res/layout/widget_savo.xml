<?xml version="1.0" encoding="utf-8"?>
<!--
    SAVO home-screen widget — native RemoteViews layout (4x2).
    Native TextViews + dot ImageViews keep text crisp and proportional at any
    widget cell size; only the donut rings are rendered as a small bitmap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <!-- White card background with subtle rounded corners -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_background"
        android:padding="14dp">

        <!-- TOP ROW: rego (left) + SAVO badge (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_rego"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="— — —"
                android:textColor="#1F2937"
                android:textSize="28sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- SAVO wordmark (tap target for actions sheet) -->
            <TextView
                android:id="@+id/widget_savo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVO"
                android:textColor="#1F2937"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.20"
                android:padding="2dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- LEGEND ROW: Insurance / WOF / Rego with colored dots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/widget_dot_green"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Insurance"
                android:textColor="#1F2937"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/widget_dot_amber"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="WOF"
                android:textColor="#1F2937"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/widget_dot_blue"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Rego"
                android:textColor="#B6BBC4"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- BOTTOM ROW: rings (left) + ACTIONS tile (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rings bitmap — sized to fill its column -->
            <ImageView
                android:id="@+id/widget_rings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_label" />

            <!-- ACTIONS tile -->
            <LinearLayout
                android:id="@+id/widget_savo_icon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_actions_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/widget_label" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ACTIONS"
                    android:textColor="#8A8F98"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tap region for cycling vehicles (top half of the card) -->
    <LinearLayout
        android:id="@+id/widget_plate_area"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
