<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Entire widget UI rendered as a single bitmap (landscape 4x2). -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label" />

    <!-- Tap regions overlay. Two columns:
         left 50% rego/legend/rings → cycle vehicle.
         right 50% large SAVO logo → opens in-app actions drawer. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left: rego + legend + rings → cycle vehicle -->
        <LinearLayout
            android:id="@+id/widget_plate_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:clickable="true"
            android:focusable="true" />

        <!-- Right: SAVO logo (vertically centered) → open actions drawer -->
        <LinearLayout
            android:id="@+id/widget_savo_icon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
