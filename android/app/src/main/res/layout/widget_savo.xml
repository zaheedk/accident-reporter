<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The entire widget UI is rendered as a single bitmap that scales to
         fit whatever size the user resizes the widget to. -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label" />

    <!-- Tap regions overlay. The bitmap is rendered with the same proportions
         (2 cols x 3 rows of content), so weights here line up with the art. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top 55% of the card: rego title + legend + rings + SAVO tile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="55"
            android:orientation="horizontal">

            <!-- Left 60%: title/legend/rings → cycles vehicle -->
            <LinearLayout
                android:id="@+id/widget_plate_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="60"
                android:clickable="true"
                android:focusable="true" />

            <!-- Right 40%: SAVO tile → quick capture -->
            <LinearLayout
                android:id="@+id/widget_savo_icon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bottom 45%: TAP TO CALL row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="45"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_call_roadside"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/widget_call_tow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/widget_call_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
