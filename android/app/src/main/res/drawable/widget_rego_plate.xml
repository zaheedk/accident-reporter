<?xml version="1.0" encoding="utf-8"?>
<!-- Rego plate background: white fill, dark rounded border, mimicking a NZ plate. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#1F2937" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#1F2937" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
