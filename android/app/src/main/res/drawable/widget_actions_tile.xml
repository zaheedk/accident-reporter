<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-style raised glass tile: soft drop shadow + subtle gradient face. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft shadow -->
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="#26000000" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="-1dp">
        <shape android:shape="oval">
            <solid android:color="#14000000" />
        </shape>
    </item>
    <!-- Glass face with vertical highlight gradient -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFF7F8FA"
                android:endColor="#FFE8ECF1" />
            <stroke android:width="0.6dp" android:color="#1A000000" />
        </shape>
    </item>
    <!-- Inner top highlight (rim light) -->
    <item
        android:left="6dp"
        android:top="3dp"
        android:right="6dp"
        android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
